# Example Configuration for AlgoTrader Pro
APP_NAME=AlgoTrader Pro
APP_VERSION=1.0.0
DEBUG=True

HOST=0.0.0.0
PORT=8000

TRADING_MODE=paper
EXCHANGE=NSE
MARKET_NAME=Indian Stock Market
CURRENCY=INR

CAPITAL=50000.0
RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=2.0
MAX_TRADES_PER_DAY=3
STOP_LOSS_PERCENT=1.5
TARGET_PERCENT=3.0

EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here
BROKER_ACCESS_TOKEN=your_token_here

DATABASE_URL=sqlite:///./data/algotrader.db
LOG_LEVEL=INFO
LOG_FILE=logs/algotrader.log
WS_UPDATE_INTERVAL=1.0
